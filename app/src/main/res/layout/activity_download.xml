<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_40"
    android:paddingBottom="@dimen/vs_20">

    <!-- 左侧：搜索输入 + 热词 -->
    <LinearLayout
        android:layout_width="@dimen/vs_360"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_50"
                android:layout_weight="1"
                android:background="@drawable/input_search"
                android:gravity="center_vertical"
                android:hint="输入关键词搜索"
                android:imeOptions="actionSearch"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/tvSearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_40"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_15"
                android:paddingRight="@dimen/vs_15"
                android:text="搜索"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/tvClear"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_40"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_15"
                android:paddingRight="@dimen/vs_15"
                android:text="清空"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10">

            <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
                android:id="@+id/keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvDownloadHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="center"
            android:text="搜索影片后点击即可选择剧集下载"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <!-- 右侧：搜索热词 + 搜索结果 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/vs_20"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:text="热门推荐"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_24" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewWord"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_80"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="visible"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/vs_15"
            android:layout_marginBottom="@dimen/vs_15"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:text="搜索结果"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_24" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
    </LinearLayout>
</LinearLayout>