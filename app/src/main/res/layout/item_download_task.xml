<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_setting_model_focus"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/vs_15">

    <TextView
        android:id="@+id/tvTaskName"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="名称"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/tvEpisodeName"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="集数"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/ts_18" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="0%"
        android:textColor="#02F8E1"
        android:textSize="@dimen/ts_20" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="等待中"
        android:textColor="#CCFFFFFF"
        android:textSize="@dimen/ts_18" />

    <TextView
        android:id="@+id/tvDelete"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vs_36"
        android:layout_marginStart="@dimen/vs_5"
        android:background="@drawable/icon_delete"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_8"
        android:paddingRight="@dimen/vs_8"
        android:text="删除"
        android:textColor="#FF4444"
        android:textSize="@dimen/ts_16" />

    <TextView
        android:id="@+id/tvRetry"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vs_36"
        android:layout_marginStart="@dimen/vs_5"
        android:background="@drawable/button_detail_sort"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_8"
        android:paddingRight="@dimen/vs_8"
        android:text="重试"
        android:textColor="#02F8E1"
        android:textSize="@dimen/ts_16"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPause"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vs_36"
        android:layout_marginStart="@dimen/vs_5"
        android:background="@drawable/button_detail_sort"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_8"
        android:paddingRight="@dimen/vs_8"
        android:text="暂停"
        android:textColor="#FFA500"
        android:textSize="@dimen/ts_16"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvOpenDir"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vs_36"
        android:layout_marginStart="@dimen/vs_5"
        android:background="@drawable/button_detail_sort"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_8"
        android:paddingRight="@dimen/vs_8"
        android:text="目录"
        android:textColor="#87CEEB"
        android:textSize="@dimen/ts_16" />
</LinearLayout>